  "lead.events": {
    "zh": "自 2027 年起，院慶系列活動陸續展開，涵蓋研討會、展覽與慶祝活動。（時程為規劃示意）",
    "en": "From 2027, seminars, exhibitions and celebrations lead up to the centennial. (Tentative)"
  },
  "lead.chronicle": {
    "zh": "從 1928 年南京創院到 2028 年百年院慶，依年代回顧重要時刻。",
    "en": "From the founding in Nanjing in 1928 to the centennial in 2028, decade by decade."
  },
  "lead.contributions": {
    "zh": "一百項改變臺灣的研究時刻，橫跨數理、生命與人文社會三大學組。（以下為示意）",
    "en": "One hundred research moments across three divisions. (Placeholders)"
  },
  "lead.news": {
    "zh": "院慶相關的最新消息與公告。",
    "en": "News and announcements about the centennial."
  },
  "lead.centennial": {
    "zh": "院長的話、院史電子書、三大學組與影音專訪。",
    "en": "A message from the president, the history e-book, our divisions and interviews."
  },
  "lead.campus": {
    "zh": "從南港山腳下的幾棟房子，到被綠意環抱的研究聚落。",
    "en": "From a few buildings at the foot of the hills to a research village in green."
  },
